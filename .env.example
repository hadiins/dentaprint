# ───────── سایت ─────────
# برای docker-compose.prod.yml
DOMAIN="shop.example.ir"
POSTGRES_PASSWORD=""
# اولین اجرا روی سرور: true (دسته‌ها، سطوح و محصولات نمونه)
SEED_ON_START="false"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── پایگاه داده (اختیاری در توسعه) ─────────
# اگر خالی باشد: محصولات نمونه، سفارش‌ها در حافظه، تنظیمات از config/commerce.json
DATABASE_URL="postgresql://dentaprint:dentaprint@localhost:5432/dentaprint?schema=public"

# ───────── ورود و امنیت ─────────
# کلید مخفی (حداقل ۳۲ کاراکتر تصادفی) — در production الزامی:  openssl rand -base64 48
AUTH_SECRET=""
# شماره‌هایی که هنگام ورود «مدیر» می‌شوند (با کاما جدا کنید)
ADMIN_PHONES="09120000000"
# توکن اختیاری برای اسکریپت‌ها و دسترسی مدیریت بدون ورود (حداقل ۱۶ کاراکتر)
ADMIN_TOKEN=""
# کلید فراخوانی ارزیابی روزانهٔ سطح‌ها: /api/cron/evaluate-tiers
CRON_SECRET=""

# ───────── حالت نمایشی (فقط توسعه) ─────────
# نمایش دکمهٔ انتخاب قیمت سطوح برای همه (و پرداخت با آن). در production حتماً false
DEMO_ALLOW_TIER_PREVIEW="false"
# بدون پایگاه داده: این شماره‌ها پس از ورود، همکار تأییدشده با سطح مشخص‌اند
DEMO_PARTNERS="09121111111:bronze,09122222222:silver,09123333333:gold"

# ───────── پرداخت ─────────
# درگاه‌های فعال به ترتیب نمایش (درگاهی که کلیدش خالی باشد خودکار غیرفعال می‌شود)
#   mock     = درگاه آزمایشی (فقط توسعه)
#   zarinpal = زرین‌پال    |   zibal = زیبال    |   درگاه‌های دیگر: src/lib/payments/gateways/_template.ts
PAYMENT_GATEWAYS="mock"
PAYMENT_DEFAULT_GATEWAY="mock"
PAYMENT_ALLOW_MOCK="false"   # فقط نسخهٔ آزمایشی روی سرور: true

# زرین‌پال
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
ZARINPAL_CURRENCY="IRT"

# زیبال  (برای تست: zibal)
ZIBAL_MERCHANT=""

# ───────── عکس محصولات ─────────
#   local = دیسک سرور (پوشهٔ UPLOAD_DIR، سرو از /media/...)  |  s3 = فضای ابری سازگار با S3 (آروان‌کلود، MinIO، لیارا)
MEDIA_STORAGE="local"
UPLOAD_DIR="./uploads"
# فقط برای s3:
S3_ENDPOINT=""
S3_REGION="default"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ACL="public-read"
# مدارک همکاران (خصوصی — هرگز داخل UPLOAD_DIR یا public نباشد)
PRIVATE_UPLOAD_DIR="./private-uploads"
# برای s3: یک باکت جدا و «خصوصی» (بدون دسترسی عمومی)
S3_PRIVATE_BUCKET=""
# آدرس عمومی فایل‌ها (CDN یا باکت)، مثلاً https://dentaprint.s3.ir-thr-at1.arvanstorage.ir
MEDIA_PUBLIC_URL=""

# ───────── پیامک (کد ورود) ─────────
#   console   = چاپ کد در کنسول سرور (فقط توسعه)
#   kavenegar = کاوه‌نگار   |   smsir = SMS.ir   |   سرویس‌های دیگر: src/lib/sms/providers/_template.ts
SMS_PROVIDER="console"
# فقط نسخهٔ آزمایشی روی سرور: کد ورود در لاگ سرور نوشته می‌شود
SMS_ALLOW_CONSOLE="false"

# کاوه‌نگار — نام الگوی تأییدشده در پنل (متن الگو باید %token% داشته باشد)
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# SMS.ir — شناسهٔ قالب و نام پارامتر کد در قالب
SMSIR_API_KEY=""
SMSIR_OTP_TEMPLATE_ID=""
SMSIR_OTP_PARAM="CODE"

# الگوهای پیامک اطلاع‌رسانی (کاوه‌نگار: نام الگو | SMS.ir: شناسهٔ عددی). رویداد بدون الگو ارسال نمی‌شود.
# پارامترها: ORDER (شمارهٔ سفارش)، TRACKING (کد رهگیری)، TIER (نام سطح)، NAME
# رویدادها: order_processing, order_shipped, order_delivered, order_cancelled, order_refunded,
#           partner_approved, partner_tier_changed, partner_rejected,
#           document_accepted, document_rejected   (پارامتر: DOC = نوع مدرک)
SMS_TEMPLATES='{"order_shipped":"dp-shipped","partner_approved":"dp-partner-ok"}'
